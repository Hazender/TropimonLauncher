<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.TropimonLauncher" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="AppTheme.SplashScreen" parent="@style/Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/AppTheme.TropimonLauncher</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_launcher</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>